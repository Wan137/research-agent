# Groq API (LLM provider) - https://console.groq.com/keys
GROQ_API_KEY=

# Tavily API (web search tool) - wired up in a later step
TAVILY_API_KEY=

# Model config
GROQ_MODEL=llama-3.3-70b-versatile

# CORS - comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Agent behavior
MAX_CRITIQUE_RETRIES=2
